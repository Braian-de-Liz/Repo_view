{
  "name": "repo_view",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target=bun --ESNext --minify --clear",
    "exe": "bun build ./src/index.ts --compile --minify --outfile dist/RepoView",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "init:exe": "./dist/RepoView"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "ai": "^6.0.168",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  }
}